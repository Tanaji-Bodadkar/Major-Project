# Carbon Intelligence Platform — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Flask
SECRET_KEY=change-this-to-a-random-secret-key
FLASK_ENV=development
FLASK_DEBUG=1

# Carbon Intensity APIs
# Electricity Maps (primary) — https://www.electricitymaps.com/free-tier-api
ELECTRICITY_MAPS_API_KEY=your_electricity_maps_api_key_here

# Climatiq (secondary fallback) — https://www.climatiq.io/
CLIMATIQ_API_KEY=your_climatiq_api_key_here

# Grid Zone for Carbon Intensity
# Electricity Maps zone code — find yours at https://app.electricitymaps.com/map
# Examples: IN-WE (India West), GB (UK), DE (Germany), US-CAL-CISO (California)
CARBON_ZONE=IN-WE

# Telemetry Settings
TELEMETRY_INTERVAL_S=5
TELEMETRY_AGGREGATION_WINDOW=1

# Static Fallback Carbon Intensity (used ONLY if both APIs fail and this is set)
# Set to a documented regional average in gCO2e/kWh
# Leave blank to disable fallback and show error instead
FALLBACK_CARBON_INTENSITY_G_PER_KWH=708
FALLBACK_CARBON_SOURCE=CEA Annual Report 2022 (India national average)

